+SAY_KEYS = ("up", "down", "left", "right", "enter", "escape", "tab", "space")
+
+
+def task_worker(s, t):
+    live = workers(s, t)
+    if not live:
+        raise Fail(f"{s.ref(t)} has no worker at work to write to.")
+    return live[-1]["address"]
+
+
+def cmd_say(args):
